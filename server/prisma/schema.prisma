generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  attendee
  admin
}

enum SessionStatus {
  draft
  join_open
  closed
}

model Event {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions  Session[]

  @@map("events")
}

model User {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid   String                 @unique @map("firebase_uid")
  email         String
  displayName   String?                @map("display_name")
  avatarUrl     String?                @map("avatar_url")
  role          UserRole               @default(attendee)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  sessionsCreated Session[]            @relation("SessionCreator")
  participants  SessionParticipant[]
  timers        ParticipantQuestionTimer[]
  answers       QuizAnswer[]

  @@map("users")
}

model Session {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                   String                 @map("event_id") @db.Uuid
  title                     String
  speakerName               String?                @map("speaker_name")
  sessionCode               String                 @unique @map("session_code")
  status                    SessionStatus          @default(draft)
  openedAt                  DateTime?              @map("opened_at") @db.Timestamptz(6)
  closedAt                  DateTime?              @map("closed_at") @db.Timestamptz(6)
  questionTimeLimitSeconds  Int                    @default(15) @map("question_time_limit_seconds")
  createdById               String?                @map("created_by") @db.Uuid
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  event                     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy                 User?                  @relation("SessionCreator", fields: [createdById], references: [id])
  questions                 Question[]
  participants              SessionParticipant[]
  timers                    ParticipantQuestionTimer[]
  answers                   QuizAnswer[]

  @@index([eventId], map: "idx_sessions_event")
  @@map("sessions")
}

model Question {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String             @map("session_id") @db.Uuid
  prompt           String
  orderIndex       Int                @map("order_index")
  timeLimitSeconds Int?               @map("time_limit_seconds")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  session          Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  options          QuestionOption[]
  timers           ParticipantQuestionTimer[]
  answers          QuizAnswer[]

  @@unique([sessionId, orderIndex])
  @@map("questions")
}

model QuestionOption {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  label      String
  isCorrect  Boolean      @default(false) @map("is_correct")
  orderIndex Int          @map("order_index")
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]

  @@map("question_options")
}

model SessionParticipant {
  sessionId          String    @map("session_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  joinedAt           DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  currentOrderIndex  Int       @default(0) @map("current_order_index")
  quizStartedAt      DateTime? @map("quiz_started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  totalScore         Int       @default(0) @map("total_score")
  session            Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([sessionId, totalScore(sort: Desc)], map: "idx_session_participants_score")
  @@map("session_participants")
}

model ParticipantQuestionTimer {
  sessionId  String   @map("session_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@map("participant_question_timers")
}

model QuizAnswer {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String          @map("session_id") @db.Uuid
  questionId    String          @map("question_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  optionId      String?         @map("option_id") @db.Uuid
  isCorrect     Boolean         @map("is_correct")
  responseMs    Int             @map("response_ms")
  pointsAwarded Int             @map("points_awarded")
  answeredAt    DateTime        @default(now()) @map("answered_at") @db.Timestamptz(6)
  session       Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question      Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  option        QuestionOption? @relation(fields: [optionId], references: [id])

  @@unique([questionId, userId])
  @@index([sessionId], map: "idx_quiz_answers_session")
  @@map("quiz_answers")
}
