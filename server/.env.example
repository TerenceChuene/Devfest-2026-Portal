DATABASE_URL=postgresql://devfest:devfest@localhost:5432/devfest_quiz
REDIS_URL=redis://localhost:6379
PORT=4000
CORS_ORIGIN=http://localhost:5000
WEB_ORIGIN=http://localhost:5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Firebase Admin (service account JSON as a single-line string, or path via FIREBASE_ADMIN_SDK_PATH)
FIREBASE_PROJECT_ID=
# FIREBASE_ADMIN_SDK_JSON={"type":"service_account",...}
FIREBASE_ADMIN_SDK_PATH=./src/firebase/serviceAccount.json

# Local-only: when set, POST /api/auth/session accepts { "devEmail": "..." } without Firebase.
# Leave empty in production.
AUTH_DEV_BYPASS=dev-bypass-secret

# Phase 3 — AI question generation (optional; CSV/manual still works without it)
GEMINI_API_KEY=
